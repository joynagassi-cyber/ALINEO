# CopilotKit runtime (server only). Never use VITE_ prefixes for credentials.
# Choose an installed provider model, for example:
#   openai/gpt-4o-mini       + OPENAI_API_KEY
#   anthropic/claude-sonnet-4-5 + ANTHROPIC_API_KEY
#   google/gemini-2.5-flash + GOOGLE_API_KEY
#   minimax/MiniMax-M2.7    + MINIMAX_API_KEY
# Keep COPILOT_MODEL empty until you have selected and configured a provider.
COPILOT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=

# Local runtime is loopback-only; Vite proxies /api/copilotkit on port 4180.
COPILOT_RUNTIME_HOST=127.0.0.1
COPILOT_RUNTIME_PORT=8200
COPILOTKIT_TELEMETRY_DISABLED=true
# Pass `false` to opt in to CopilotKit telemetry.
# Optional comma-separated exact origins only when the browser calls the runtime cross-origin.
# A same-origin Vite/reverse proxy does not need this.
COPILOT_ALLOWED_ORIGINS=
