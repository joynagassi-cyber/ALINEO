{
  "name": "alineo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names runtime,web \"npm:dev:runtime\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:runtime": "tsx watch server.ts",
    "build": "npm run typecheck && vite build && npm run build:runtime",
    "build:runtime": "tsc -p tsconfig.server.json",
    "start:runtime": "node dist-server/server.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "^1.90.2",
    "@copilotkit/react-core": "^1.90.2",
    "@copilotkit/runtime": "^1.90.2",
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "hono": "^4.13.21",
    "lucide-react": "0.563.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "27.3.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@fastify/busboy": "3.2.2",
    "@hono/node-server": "$@hono/node-server",
    "esbuild": "0.28.2",
    "graphql-scalars": "1.24.0",
    "katex": "0.18.2",
    "streamdown": "2.8.1",
    "undici": "6.29.1",
    "zod": "4.6.7"
  }
}
