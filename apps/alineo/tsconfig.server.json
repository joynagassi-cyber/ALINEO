{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server.ts", "server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
